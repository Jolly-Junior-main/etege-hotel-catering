rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check admin / staff authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'owner';
    }
    
    function isHotelStaff() {
      return isAuthenticated() && (request.auth.token.role == 'hotel_staff' || request.auth.token.role == 'owner');
    }
    
    function isCateringManager() {
      return isAuthenticated() && (request.auth.token.role == 'catering_manager' || request.auth.token.role == 'owner');
    }

    // Public catalog data (Rooms, Packages, Gallery, Settings)
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isHotelStaff();
    }

    match /catering_packages/{pkgId} {
      allow read: if true;
      allow write: if isCateringManager();
    }

    match /gallery/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    match /site_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer Inquiries: Public can CREATE only, Staff can READ/UPDATE
    match /room_reservations/{reservationId} {
      allow create: if request.resource.data.customerEmail is string
                    && request.resource.data.customerPhone is string
                    && request.resource.data.checkInDate is string;
      allow read, update, delete: if isHotelStaff();
    }

    match /catering_inquiries/{inquiryId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.phone is string
                    && request.resource.data.eventDate is string;
      allow read, update, delete: if isCateringManager();
    }

    match /contact_inquiries/{contactId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.message is string;
      allow read, update, delete: if isAuthenticated();
    }

    // Audit logs & Internal User Profiles
    match /users/{userId} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
